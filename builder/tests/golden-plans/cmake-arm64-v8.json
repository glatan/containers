{
  "Steps": {
    "env": "None",
    "pgo": null,
    "std": "Gnu17",
    "steps": [
      {
        "Exec": {
          "env": [],
          "pipe": {
            "stages": [
              [
                {
                  "Lit": "cmake"
                },
                {
                  "Lit": "-S"
                },
                {
                  "Quoted": {
                    "Var": "SOURCE"
                  }
                },
                {
                  "Lit": "-B"
                },
                {
                  "Quoted": {
                    "Var": "BUILD"
                  }
                },
                {
                  "Lit": "-DCMAKE_SYSTEM_NAME=Linux"
                },
                {
                  "Lit": "-DCMAKE_SYSTEM_PROCESSOR=aarch64"
                },
                {
                  "Lit": "-DCMAKE_SYSROOT=/tmp/sysroot"
                },
                {
                  "Lit": "-DCMAKE_BUILD_TYPE=Release"
                },
                {
                  "Lit": "-DCMAKE_INSTALL_PREFIX=/usr"
                },
                {
                  "Lit": "-DCMAKE_USE_OPENSSL=OFF"
                },
                {
                  "Lit": "-DCMAKE_DISABLE_FIND_PACKAGE_Libidn2=ON"
                },
                {
                  "Lit": "-DBUILD_TESTING=OFF"
                },
                {
                  "Concat": [
                    {
                      "Lit": "-DCMAKE_C_COMPILER="
                    },
                    {
                      "Quoted": {
                        "Var": "CC"
                      }
                    }
                  ]
                },
                {
                  "Concat": [
                    {
                      "Lit": "-DCMAKE_CXX_COMPILER="
                    },
                    {
                      "Quoted": {
                        "Var": "CXX"
                      }
                    }
                  ]
                }
              ]
            ],
            "stderr": null,
            "stdin": null,
            "stdout": null
          }
        }
      },
      {
        "Exec": {
          "env": [],
          "pipe": {
            "stages": [
              [
                {
                  "Lit": "cmake"
                },
                {
                  "Lit": "--build"
                },
                {
                  "Quoted": {
                    "Var": "BUILD"
                  }
                },
                {
                  "Concat": [
                    {
                      "Lit": "-j"
                    },
                    {
                      "Subst": {
                        "stages": [
                          [
                            {
                              "Lit": "nproc"
                            }
                          ]
                        ],
                        "stderr": null,
                        "stdin": null,
                        "stdout": null
                      }
                    }
                  ]
                }
              ]
            ],
            "stderr": null,
            "stdin": null,
            "stdout": null
          }
        }
      },
      {
        "Exec": {
          "env": [
            [
              "DESTDIR",
              {
                "Quoted": {
                  "Var": "OUT"
                }
              }
            ]
          ],
          "pipe": {
            "stages": [
              [
                {
                  "Lit": "cmake"
                },
                {
                  "Lit": "--install"
                },
                {
                  "Quoted": {
                    "Var": "BUILD"
                  }
                }
              ]
            ],
            "stderr": null,
            "stdin": null,
            "stdout": null
          }
        }
      }
    ],
    "sysroot": true,
    "workdir": "Build"
  }
}
