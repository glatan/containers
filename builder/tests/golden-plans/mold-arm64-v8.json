{
  "Steps": {
    "env": "None",
    "pgo": null,
    "std": "Gnu17",
    "steps": [
      {
        "Set": {
          "name": "CMAKE_PREFIX",
          "value": {
            "Lit": ""
          }
        }
      },
      {
        "ForEach": {
          "body": [
            {
              "If": {
                "cond": {
                  "DirExists": {
                    "Concat": [
                      {
                        "Lit": "/dep/"
                      },
                      {
                        "Var": "_dep"
                      },
                      {
                        "Lit": "/usr"
                      }
                    ]
                  }
                },
                "else_": [],
                "then": [
                  {
                    "Set": {
                      "name": "CMAKE_PREFIX",
                      "value": {
                        "Quoted": {
                          "Concat": [
                            {
                              "Lit": "${CMAKE_PREFIX:+$CMAKE_PREFIX:}/dep/"
                            },
                            {
                              "Var": "_dep"
                            },
                            {
                              "Lit": "/usr"
                            }
                          ]
                        }
                      }
                    }
                  }
                ]
              }
            }
          ],
          "items": [
            {
              "Lit": "zlib"
            },
            {
              "Lit": "zstd"
            }
          ],
          "stdout": null,
          "var": "_dep"
        }
      },
      {
        "If": {
          "cond": {
            "EnvSet": "CMAKE_PREFIX"
          },
          "else_": [],
          "then": [
            {
              "Export": {
                "name": "CMAKE_PREFIX_PATH",
                "value": {
                  "Quoted": {
                    "Concat": [
                      {
                        "Var": "CMAKE_PREFIX"
                      },
                      {
                        "Lit": "${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      {
        "If": {
          "cond": {
            "DirExists": {
              "Lit": "/dep/cmake/usr/bin"
            }
          },
          "else_": [],
          "then": [
            {
              "Export": {
                "name": "PATH",
                "value": {
                  "Quoted": {
                    "Concat": [
                      {
                        "Lit": "/dep/cmake/usr/bin:"
                      },
                      {
                        "Var": "PATH"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      {
        "Cmake": {
          "args": [
            {
              "Lit": "-DCMAKE_SYSTEM_NAME=Linux"
            },
            {
              "Lit": "-DCMAKE_SYSTEM_PROCESSOR=aarch64"
            },
            {
              "Lit": "-DCMAKE_C_COMPILER_TARGET=aarch64-linux-gnu"
            },
            {
              "Lit": "-DCMAKE_CXX_COMPILER_TARGET=aarch64-linux-gnu"
            },
            {
              "Lit": "-DCMAKE_BUILD_TYPE=Release"
            },
            {
              "Lit": "-DCMAKE_INSTALL_PREFIX=/usr"
            },
            {
              "Concat": [
                {
                  "Lit": "-DCMAKE_C_COMPILER="
                },
                {
                  "Quoted": {
                    "Var": "CC"
                  }
                }
              ]
            },
            {
              "Concat": [
                {
                  "Lit": "-DCMAKE_CXX_COMPILER="
                },
                {
                  "Quoted": {
                    "Var": "CXX"
                  }
                }
              ]
            },
            {
              "Concat": [
                {
                  "Lit": "-DCMAKE_C_FLAGS="
                },
                {
                  "Quoted": {
                    "Concat": [
                      {
                        "Lit": "${CFLAGS:-}"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "Concat": [
                {
                  "Lit": "-DCMAKE_CXX_FLAGS="
                },
                {
                  "Quoted": {
                    "Concat": [
                      {
                        "Lit": "${CXXFLAGS:-}"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "Concat": [
                {
                  "Lit": "-DCMAKE_EXE_LINKER_FLAGS="
                },
                {
                  "Quoted": {
                    "Concat": [
                      {
                        "Lit": "${LDFLAGS:-}"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "Concat": [
                {
                  "Lit": "-DCMAKE_SHARED_LINKER_FLAGS="
                },
                {
                  "Quoted": {
                    "Concat": [
                      {
                        "Lit": "${LDFLAGS:-}"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "Lit": "-DMOLD_USE_MIMALLOC=ON"
            },
            {
              "Lit": "-DMOLD_USE_SYSTEM_MIMALLOC=OFF"
            },
            {
              "Lit": "-DMOLD_USE_SYSTEM_TBB=OFF"
            }
          ],
          "build_dir": {
            "Quoted": {
              "Var": "BUILD"
            }
          },
          "env": [],
          "source_dir": {
            "Quoted": {
              "Var": "SOURCE"
            }
          }
        }
      },
      {
        "Exec": {
          "env": [],
          "pipe": {
            "stages": [
              [
                {
                  "Lit": "cmake"
                },
                {
                  "Lit": "--build"
                },
                {
                  "Quoted": {
                    "Var": "BUILD"
                  }
                },
                {
                  "Concat": [
                    {
                      "Lit": "-j"
                    },
                    {
                      "Subst": {
                        "stages": [
                          [
                            {
                              "Lit": "nproc"
                            }
                          ]
                        ],
                        "stderr": null,
                        "stdin": null,
                        "stdout": null
                      }
                    }
                  ]
                }
              ]
            ],
            "stderr": null,
            "stdin": null,
            "stdout": null
          }
        }
      },
      {
        "Exec": {
          "env": [],
          "pipe": {
            "stages": [
              [
                {
                  "Lit": "cmake"
                },
                {
                  "Lit": "--install"
                },
                {
                  "Quoted": {
                    "Var": "BUILD"
                  }
                },
                {
                  "Lit": "--prefix"
                },
                {
                  "Quoted": {
                    "Concat": [
                      {
                        "Var": "OUT"
                      },
                      {
                        "Lit": "/usr"
                      }
                    ]
                  }
                }
              ]
            ],
            "stderr": null,
            "stdin": null,
            "stdout": null
          }
        }
      }
    ],
    "sysroot": true,
    "workdir": "None"
  }
}
