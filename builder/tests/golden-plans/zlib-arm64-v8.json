{
  "Steps": {
    "env": "None",
    "pgo": null,
    "std": "Gnu17",
    "steps": [
      {
        "If": {
          "cond": {
            "EnvSet": "SYSROOT"
          },
          "else_": [],
          "then": [
            {
              "Export": {
                "name": "CC",
                "value": {
                  "Quoted": {
                    "Concat": [
                      {
                        "Var": "CC"
                      },
                      {
                        "Lit": " --sysroot="
                      },
                      {
                        "Var": "SYSROOT"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      {
        "Set": {
          "name": "PGO",
          "value": {
            "Lit": "/tmp/zlib-pgo"
          }
        }
      },
      {
        "Exec": {
          "env": [],
          "pipe": {
            "stages": [
              [
                {
                  "Lit": "rm"
                },
                {
                  "Lit": "-rf"
                },
                {
                  "Lit": "\"$PGO\""
                }
              ]
            ],
            "stderr": null,
            "stdin": null,
            "stdout": null
          }
        }
      },
      {
        "Exec": {
          "env": [],
          "pipe": {
            "stages": [
              [
                {
                  "Lit": "mkdir"
                },
                {
                  "Lit": "-p"
                },
                {
                  "Lit": "\"$PGO\""
                }
              ]
            ],
            "stderr": null,
            "stdin": null,
            "stdout": null
          }
        }
      },
      {
        "ConfigureScript": {
          "args": [
            {
              "Lit": "--prefix=/usr"
            },
            {
              "Lit": "--libdir=/usr/lib64"
            },
            {
              "Lit": "--shared"
            }
          ],
          "env": [
            [
              "CHOST",
              {
                "Quoted": {
                  "Var": "TRIPLE"
                }
              }
            ]
          ],
          "program": [
            {
              "Lit": "./configure"
            }
          ]
        }
      },
      {
        "Make": {
          "args": [],
          "jobs": true
        }
      },
      {
        "MakeInstall": {
          "vars": []
        }
      }
    ],
    "sysroot": true,
    "workdir": "InSource"
  }
}
