{
  "Steps": {
    "env": "None",
    "pgo": null,
    "std": "Gnu17",
    "steps": [
      {
        "Unset": "CPP"
      },
      {
        "Export": {
          "name": "PATH",
          "value": {
            "Quoted": {
              "Concat": [
                {
                  "Lit": "/dep/"
                },
                {
                  "Var": "TRIPLE"
                },
                {
                  "Lit": "-binutils/usr/bin:"
                },
                {
                  "Var": "PATH"
                }
              ]
            }
          }
        }
      },
      {
        "Set": {
          "name": "PREFIX",
          "value": {
            "Concat": [
              {
                "Lit": "/usr/lib/cross/"
              },
              {
                "Var": "TRIPLE"
              },
              {
                "Lit": "/stage2"
              }
            ]
          }
        }
      },
      {
        "Set": {
          "name": "SYSROOT",
          "value": {
            "Concat": [
              {
                "Lit": "/usr/"
              },
              {
                "Var": "TRIPLE"
              }
            ]
          }
        }
      },
      {
        "Exec": {
          "env": [],
          "pipe": {
            "stages": [
              [
                {
                  "Lit": "mkdir"
                },
                {
                  "Lit": "-p"
                },
                {
                  "Var": "SYSROOT"
                },
                {
                  "Var": "BUILD"
                }
              ]
            ],
            "stderr": null,
            "stdin": null,
            "stdout": null
          }
        }
      },
      {
        "If": {
          "cond": {
            "DirExists": {
              "Concat": [
                {
                  "Lit": "/dep/"
                },
                {
                  "Var": "TRIPLE"
                },
                {
                  "Lit": "-glibc-headers/usr/"
                },
                {
                  "Var": "TRIPLE"
                }
              ]
            }
          },
          "else_": [],
          "then": [
            {
              "Exec": {
                "env": [],
                "pipe": {
                  "stages": [
                    [
                      {
                        "Lit": "cp"
                      },
                      {
                        "Lit": "-a"
                      },
                      {
                        "Concat": [
                          {
                            "Concat": [
                              {
                                "Lit": "/dep/"
                              },
                              {
                                "Var": "TRIPLE"
                              },
                              {
                                "Lit": "-glibc-headers/usr/"
                              },
                              {
                                "Var": "TRIPLE"
                              }
                            ]
                          },
                          {
                            "Lit": "/."
                          }
                        ]
                      },
                      {
                        "Concat": [
                          {
                            "Var": "SYSROOT"
                          },
                          {
                            "Lit": "/"
                          }
                        ]
                      }
                    ]
                  ],
                  "stderr": null,
                  "stdin": null,
                  "stdout": null
                }
              }
            }
          ]
        }
      },
      {
        "Set": {
          "name": "HDR",
          "value": {
            "Concat": [
              {
                "Lit": "/dep/linux-headers/usr/"
              },
              {
                "Var": "TRIPLE"
              },
              {
                "Lit": "/include"
              }
            ]
          }
        }
      },
      {
        "Or": {
          "lhs": [
            {
              "Exec": {
                "env": [],
                "pipe": {
                  "stages": [
                    [
                      {
                        "Lit": "["
                      },
                      {
                        "Lit": "-d"
                      },
                      {
                        "Var": "HDR"
                      },
                      {
                        "Lit": "]"
                      }
                    ]
                  ],
                  "stderr": null,
                  "stdin": null,
                  "stdout": null
                }
              }
            }
          ],
          "rhs": [
            {
              "Set": {
                "name": "HDR",
                "value": {
                  "Lit": "/dep/linux-headers/usr/include"
                }
              }
            }
          ]
        }
      },
      {
        "Exec": {
          "env": [],
          "pipe": {
            "stages": [
              [
                {
                  "Lit": "mkdir"
                },
                {
                  "Lit": "-p"
                },
                {
                  "Concat": [
                    {
                      "Var": "SYSROOT"
                    },
                    {
                      "Lit": "/include"
                    }
                  ]
                }
              ]
            ],
            "stderr": null,
            "stdin": null,
            "stdout": null
          }
        }
      },
      {
        "Exec": {
          "env": [],
          "pipe": {
            "stages": [
              [
                {
                  "Lit": "cp"
                },
                {
                  "Lit": "-a"
                },
                {
                  "Concat": [
                    {
                      "Var": "HDR"
                    },
                    {
                      "Lit": "/."
                    }
                  ]
                },
                {
                  "Concat": [
                    {
                      "Var": "SYSROOT"
                    },
                    {
                      "Lit": "/include/"
                    }
                  ]
                }
              ]
            ],
            "stderr": null,
            "stdin": null,
            "stdout": null
          }
        }
      },
      {
        "Exec": {
          "env": [],
          "pipe": {
            "stages": [
              [
                {
                  "Lit": "ln"
                },
                {
                  "Lit": "-sfn"
                },
                {
                  "Concat": [
                    {
                      "Lit": "/dep/"
                    },
                    {
                      "Var": "TRIPLE"
                    },
                    {
                      "Lit": "-binutils/usr/bin/"
                    },
                    {
                      "Var": "TRIPLE"
                    },
                    {
                      "Lit": "-as"
                    }
                  ]
                },
                {
                  "Concat": [
                    {
                      "Lit": "/usr/bin/"
                    },
                    {
                      "Var": "TRIPLE"
                    },
                    {
                      "Lit": "-as"
                    }
                  ]
                }
              ]
            ],
            "stderr": null,
            "stdin": null,
            "stdout": null
          }
        }
      },
      {
        "Exec": {
          "env": [],
          "pipe": {
            "stages": [
              [
                {
                  "Lit": "ln"
                },
                {
                  "Lit": "-sfn"
                },
                {
                  "Concat": [
                    {
                      "Lit": "/dep/"
                    },
                    {
                      "Var": "TRIPLE"
                    },
                    {
                      "Lit": "-binutils/usr/bin/"
                    },
                    {
                      "Var": "TRIPLE"
                    },
                    {
                      "Lit": "-ld"
                    }
                  ]
                },
                {
                  "Concat": [
                    {
                      "Lit": "/usr/bin/"
                    },
                    {
                      "Var": "TRIPLE"
                    },
                    {
                      "Lit": "-ld"
                    }
                  ]
                }
              ]
            ],
            "stderr": null,
            "stdin": null,
            "stdout": null
          }
        }
      },
      {
        "If": {
          "cond": {
            "DirExists": {
              "Lit": "/dep/gmp/usr"
            }
          },
          "else_": [
            {
              "Set": {
                "name": "GCC_LIB_FLAGS",
                "value": {
                  "Lit": "--with-isl"
                }
              }
            }
          ],
          "then": [
            {
              "Set": {
                "name": "GCC_LIB_FLAGS",
                "value": {
                  "Quoted": {
                    "Lit": "--with-gmp=/dep/gmp/usr --with-mpfr=/dep/mpfr/usr --with-mpc=/dep/mpc/usr --with-isl=/dep/isl/usr"
                  }
                }
              }
            }
          ]
        }
      },
      {
        "If": {
          "cond": {
            "DirExists": {
              "Concat": [
                {
                  "Lit": "/dep/"
                },
                {
                  "Lit": "zlib"
                },
                {
                  "Lit": "/usr/include"
                }
              ]
            }
          },
          "else_": [],
          "then": [
            {
              "Export": {
                "name": "CFLAGS",
                "value": {
                  "Quoted": {
                    "Concat": [
                      {
                        "Lit": " -I/dep/"
                      },
                      {
                        "Lit": "zlib"
                      },
                      {
                        "Lit": "/usr/include"
                      }
                    ]
                  }
                }
              }
            },
            {
              "Export": {
                "name": "CXXFLAGS",
                "value": {
                  "Quoted": {
                    "Concat": [
                      {
                        "Lit": " -I/dep/"
                      },
                      {
                        "Lit": "zlib"
                      },
                      {
                        "Lit": "/usr/include"
                      }
                    ]
                  }
                }
              }
            },
            {
              "Export": {
                "name": "LDFLAGS",
                "value": {
                  "Quoted": {
                    "Concat": [
                      {
                        "Lit": " -L/dep/"
                      },
                      {
                        "Lit": "zlib"
                      },
                      {
                        "Lit": "/usr/lib64 -L/dep/"
                      },
                      {
                        "Lit": "zlib"
                      },
                      {
                        "Lit": "/usr/lib"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      {
        "If": {
          "cond": {
            "DirExists": {
              "Concat": [
                {
                  "Lit": "/dep/"
                },
                {
                  "Lit": "zstd"
                },
                {
                  "Lit": "/usr/include"
                }
              ]
            }
          },
          "else_": [],
          "then": [
            {
              "Export": {
                "name": "CFLAGS",
                "value": {
                  "Quoted": {
                    "Concat": [
                      {
                        "Lit": " -I/dep/"
                      },
                      {
                        "Lit": "zstd"
                      },
                      {
                        "Lit": "/usr/include"
                      }
                    ]
                  }
                }
              }
            },
            {
              "Export": {
                "name": "CXXFLAGS",
                "value": {
                  "Quoted": {
                    "Concat": [
                      {
                        "Lit": " -I/dep/"
                      },
                      {
                        "Lit": "zstd"
                      },
                      {
                        "Lit": "/usr/include"
                      }
                    ]
                  }
                }
              }
            },
            {
              "Export": {
                "name": "LDFLAGS",
                "value": {
                  "Quoted": {
                    "Concat": [
                      {
                        "Lit": " -L/dep/"
                      },
                      {
                        "Lit": "zstd"
                      },
                      {
                        "Lit": "/usr/lib64 -L/dep/"
                      },
                      {
                        "Lit": "zstd"
                      },
                      {
                        "Lit": "/usr/lib"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      {
        "Cd": {
          "Var": "BUILD"
        }
      },
      {
        "ConfigureScript": {
          "args": [
            {
              "Opt": [
                "build",
                {
                  "Var": "HOST_TRIPLE"
                }
              ]
            },
            {
              "Opt": [
                "host",
                {
                  "Var": "HOST_TRIPLE"
                }
              ]
            },
            {
              "Opt": [
                "target",
                {
                  "Var": "TRIPLE"
                }
              ]
            },
            {
              "Opt": [
                "program-prefix",
                {
                  "Concat": [
                    {
                      "Var": "TRIPLE"
                    },
                    {
                      "Lit": "-"
                    }
                  ]
                }
              ]
            },
            {
              "Opt": [
                "prefix",
                {
                  "Concat": [
                    {
                      "Lit": "/usr/lib/cross/"
                    },
                    {
                      "Var": "TRIPLE"
                    },
                    {
                      "Lit": "/stage2"
                    }
                  ]
                }
              ]
            },
            {
              "Opt": [
                "with-sysroot",
                {
                  "Concat": [
                    {
                      "Lit": "/usr/"
                    },
                    {
                      "Var": "TRIPLE"
                    }
                  ]
                }
              ]
            },
            {
              "Opt": [
                "with-build-sysroot",
                {
                  "Concat": [
                    {
                      "Lit": "/usr/"
                    },
                    {
                      "Var": "TRIPLE"
                    }
                  ]
                }
              ]
            },
            {
              "Lit": "--with-native-system-header-dir=/include"
            },
            {
              "Opt": [
                "with-as",
                {
                  "Concat": [
                    {
                      "Lit": "/usr/bin/"
                    },
                    {
                      "Var": "TRIPLE"
                    },
                    {
                      "Lit": "-as"
                    }
                  ]
                }
              ]
            },
            {
              "Opt": [
                "with-ld",
                {
                  "Concat": [
                    {
                      "Lit": "/usr/bin/"
                    },
                    {
                      "Var": "TRIPLE"
                    },
                    {
                      "Lit": "-ld"
                    }
                  ]
                }
              ]
            },
            {
              "Concat": [
                {
                  "Lit": "--infodir=/usr/share/info/"
                },
                {
                  "Var": "TRIPLE"
                }
              ]
            },
            {
              "Lit": "--with-system-zlib"
            },
            {
              "Var": "GCC_LIB_FLAGS"
            },
            {
              "Lit": "--with-cpu=power8"
            },
            {
              "Lit": "--disable-nls"
            },
            {
              "Lit": "--disable-multilib"
            },
            {
              "Lit": "--disable-werror"
            },
            {
              "Lit": "--disable-libatomic"
            },
            {
              "Lit": "--disable-libsanitizer"
            },
            {
              "Lit": "--disable-libssp"
            },
            {
              "Lit": "--disable-libquadmath"
            },
            {
              "Lit": "--disable-libgomp"
            },
            {
              "Lit": "--disable-libstdcxx"
            },
            {
              "Lit": "--disable-libvtv"
            },
            {
              "Lit": "--disable-bootstrap"
            },
            {
              "Lit": "--enable-shared"
            },
            {
              "Lit": "--enable-threads=posix"
            },
            {
              "Lit": "--enable-languages=c"
            },
            {
              "Lit": "--enable-lto"
            },
            {
              "Lit": "--enable-plugin"
            },
            {
              "Lit": "--enable-checking=release"
            },
            {
              "Lit": "--enable-default-pie"
            },
            {
              "Lit": "--enable-default-ssp"
            },
            {
              "Lit": "--with-linker-hash-style=gnu"
            },
            {
              "Lit": "--enable-linker-build-id"
            },
            {
              "Lit": "--enable-gnu-indirect-function"
            },
            {
              "Lit": "--enable-gnu-unique-object"
            },
            {
              "Lit": "--enable-initfini-array"
            }
          ],
          "env": [],
          "program": [
            {
              "Concat": [
                {
                  "Var": "SOURCE"
                },
                {
                  "Lit": "/configure"
                }
              ]
            }
          ]
        }
      },
      {
        "Make": {
          "args": [
            "all-gcc",
            "all-target-libgcc"
          ],
          "jobs": true
        }
      },
      {
        "Make": {
          "args": [
            "DESTDIR=\"$OUT\"",
            "install-gcc",
            "install-target-libgcc"
          ],
          "jobs": false
        }
      }
    ],
    "sysroot": false,
    "workdir": "None"
  }
