{
  "Steps": {
    "env": "Autotools",
    "pgo": {
      "Autotools": [
        {
          "ForEach": {
            "body": [
              {
                "Exec": {
                  "env": [],
                  "pipe": {
                    "stages": [
                      [
                        {
                          "Lit": "cat"
                        },
                        {
                          "Lit": "\"$SOURCE\"/*.c"
                        },
                        {
                          "Lit": "\"$SOURCE\"/*.h"
                        }
                      ]
                    ],
                    "stderr": {
                      "Lit": "/dev/null"
                    },
                    "stdin": null,
                    "stdout": null
                  }
                }
              }
            ],
            "items": [
              {
                "Lit": "1"
              },
              {
                "Lit": "2"
              },
              {
                "Lit": "3"
              },
              {
                "Lit": "4"
              },
              {
                "Lit": "5"
              },
              {
                "Lit": "6"
              },
              {
                "Lit": "7"
              },
              {
                "Lit": "8"
              }
            ],
            "stdout": {
              "append": false,
              "target": {
                "Lit": "/tmp/pgo-input"
              }
            },
            "var": "_i"
          }
        },
        {
          "Exec": {
            "env": [],
            "pipe": {
              "stages": [
                [
                  {
                    "Lit": "./gzip"
                  },
                  {
                    "Lit": "-9"
                  },
                  {
                    "Lit": "-c"
                  },
                  {
                    "Lit": "/tmp/pgo-input"
                  }
                ],
                [
                  {
                    "Lit": "./gzip"
                  },
                  {
                    "Lit": "-d"
                  },
                  {
                    "Lit": "-c"
                  }
                ]
              ],
              "stderr": null,
              "stdin": null,
              "stdout": {
                "append": false,
                "target": {
                  "Lit": "/dev/null"
                }
              }
            }
          }
        },
        {
          "Exec": {
            "env": [],
            "pipe": {
              "stages": [
                [
                  {
                    "Lit": "./gzip"
                  },
                  {
                    "Lit": "-1"
                  },
                  {
                    "Lit": "-c"
                  },
                  {
                    "Lit": "/tmp/pgo-input"
                  }
                ],
                [
                  {
                    "Lit": "./gzip"
                  },
                  {
                    "Lit": "-d"
                  },
                  {
                    "Lit": "-c"
                  }
                ]
              ],
              "stderr": null,
              "stdin": null,
              "stdout": {
                "append": false,
                "target": {
                  "Lit": "/dev/null"
                }
              }
            }
          }
        }
      ]
    },
    "std": "Gnu17",
    "steps": [
      {
        "Configure": [
          "--prefix=/usr"
        ]
      },
      {
        "Make": {
          "args": [],
          "jobs": true
        }
      },
      {
        "MakeInstall": {
          "vars": []
        }
      }
    ],
    "sysroot": true,
    "workdir": "Build"
  }
}
