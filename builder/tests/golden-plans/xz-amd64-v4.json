{
  "Steps": {
    "env": "Autotools",
    "pgo": {
      "Autotools": [
        {
          "ForEach": {
            "body": [
              {
                "Exec": {
                  "env": [],
                  "pipe": {
                    "stages": [
                      [
                        {
                          "Lit": "find"
                        },
                        {
                          "Lit": "\"$SOURCE\""
                        },
                        {
                          "Lit": "-name"
                        },
                        {
                          "Lit": "'*.c'"
                        },
                        {
                          "Lit": "-o"
                        },
                        {
                          "Lit": "-name"
                        },
                        {
                          "Lit": "'*.h'"
                        }
                      ],
                      [
                        {
                          "Lit": "xargs"
                        },
                        {
                          "Lit": "cat"
                        }
                      ]
                    ],
                    "stderr": null,
                    "stdin": null,
                    "stdout": null
                  }
                }
              }
            ],
            "items": [
              {
                "Lit": "1"
              },
              {
                "Lit": "2"
              },
              {
                "Lit": "3"
              },
              {
                "Lit": "4"
              },
              {
                "Lit": "5"
              },
              {
                "Lit": "6"
              },
              {
                "Lit": "7"
              },
              {
                "Lit": "8"
              }
            ],
            "stdout": {
              "append": false,
              "target": {
                "Lit": "/tmp/pgo-input"
              }
            },
            "var": "_i"
          }
        },
        {
          "ForEach": {
            "body": [
              {
                "Exec": {
                  "env": [],
                  "pipe": {
                    "stages": [
                      [
                        {
                          "Lit": "./src/xz/xz"
                        },
                        {
                          "Lit": "-T4"
                        },
                        {
                          "Lit": "\"$_opt\""
                        },
                        {
                          "Lit": "-c"
                        },
                        {
                          "Lit": "/tmp/pgo-input"
                        }
                      ],
                      [
                        {
                          "Lit": "./src/xz/xz"
                        },
                        {
                          "Lit": "-d"
                        },
                        {
                          "Lit": "-c"
                        }
                      ]
                    ],
                    "stderr": null,
                    "stdin": null,
                    "stdout": {
                      "append": false,
                      "target": {
                        "Lit": "/dev/null"
                      }
                    }
                  }
                }
              }
            ],
            "items": [
              {
                "Lit": "-0"
              },
              {
                "Lit": "-6"
              },
              {
                "Lit": "-9e"
              }
            ],
            "stdout": null,
            "var": "_opt"
          }
        }
      ]
    },
    "std": "Gnu17",
    "steps": [
      {
        "Configure": [
          "--prefix=/usr"
        ]
      },
      {
        "Make": {
          "args": [],
          "jobs": true
        }
      },
      {
        "MakeInstall": {
          "vars": []
        }
      }
    ],
    "sysroot": true,
    "workdir": "Build"
  }
}
