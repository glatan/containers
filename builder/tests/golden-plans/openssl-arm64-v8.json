{
  "Steps": {
    "env": "None",
    "pgo": null,
    "std": "Gnu17",
    "steps": [
      {
        "If": {
          "cond": {
            "EnvSet": "SYSROOT"
          },
          "else_": [],
          "then": [
            {
              "Export": {
                "name": "CC",
                "value": {
                  "Quoted": {
                    "Concat": [
                      {
                        "Var": "CC"
                      },
                      {
                        "Lit": " --sysroot="
                      },
                      {
                        "Var": "SYSROOT"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      {
        "ConfigureScript": {
          "args": [
            {
              "Lit": "linux-aarch64"
            },
            {
              "Lit": "--prefix=/usr"
            },
            {
              "Lit": "--openssldir=/etc/ssl"
            },
            {
              "Lit": "--libdir=lib64"
            }
          ],
          "env": [],
          "program": [
            {
              "Quoted": {
                "Concat": [
                  {
                    "Var": "SOURCE"
                  },
                  {
                    "Lit": "/Configure"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "Make": {
          "args": [],
          "jobs": true
        }
      },
      {
        "Exec": {
          "env": [],
          "pipe": {
            "stages": [
              [
                {
                  "Lit": "make"
                },
                {
                  "Lit": "install_sw"
                },
                {
                  "Concat": [
                    {
                      "Lit": "DESTDIR="
                    },
                    {
                      "Quoted": {
                        "Var": "OUT"
                      }
                    }
                  ]
                }
              ]
            ],
            "stderr": null,
            "stdin": null,
            "stdout": null
          }
        }
      }
    ],
    "sysroot": true,
    "workdir": "Build"
  }
}
