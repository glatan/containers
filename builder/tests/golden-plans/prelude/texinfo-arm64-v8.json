      }
    },
    {
      "Comment": "Never export LD=*-gcc: libtool then reports \"is GNU ld... no\" and skips\nthe real -shared link (gmp install: dangling libgmp.so.*)."
    },
    {
      "Exec": {
        "env": [],
        "pipe": {
          "stages": [
            [
              {
                "Lit": "mkdir"
              },
              {
                "Lit": "-p"
              },
              {
                "Lit": "/tmp/la-overlay"
              },
              {
                "Lit": "/tmp/pc-overlay"
              }
            ]
