                      }
                    ],
                    "path": {
                      "Lit": "\"$_pc_wrap/pkg-config\""
                    }
                  }
                }
              ]
            }
          }
        ],
        "then": [
          {
            "WriteFile": {
              "append": false,
              "expand": false,
              "lines": [
                {
                  "Lit": "#!/bin/sh"
                },
                {
                  "Lit": "exec pkgconf \"$@\""
                }
              ],
              "path": {
                "Lit": "\"$_pc_wrap/pkg-config\""
              }
