              "target": {
                "Lit": "/dev/null"
              }
            }
          }
        },
        "else_": [
          {
            "If": {
              "cond": {
                "Cmd": {
                  "stages": [
                    [
                      {
                        "Lit": "command"
                      },
                      {
                        "Lit": "-v"
                      },
                      {
                        "Lit": "pkg-config"
                      }
                    ]
                  ],
                  "stderr": {
                    "Lit": "/dev/null"
                  },
                  "stdin": null,
                  "stdout": {
                    "append": false,
