                                },
                                {
                                  "Lit": "+x"
                                },
                                {
                                  "Lit": "\"$_mold_wrap/$_name\""
                                }
                              ]
                            ],
                            "stderr": null,
                            "stdin": null,
                            "stdout": null
                          }
                        }
                      }
