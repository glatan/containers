          }
        },
        "else_": [],
        "then": [
          {
            "ForEach": {
              "body": [
                {
                  "Set": {
                    "name": "_src",
                    "value": {
                      "SubstOr": {
                        "stages": [
                          [
                            {
                              "Lit": "command"
                            },
                            {
                              "Lit": "-v"
                            },
                            {
                              "Lit": "\"$_name\""
                            }
                          ]
                        ],
                        "stderr": null,
                        "stdin": null,
                        "stdout": null
                      }
                    }
                  }
                },
                {
                  "If": {
                    "cond": {
                      "And": [
                        {
                          "NonEmpty": {
                            "Lit": "\"$_src\""
                          }
                        },
                        {
                          "Executable": {
                            "Lit": "\"$_src\""
                          }
                        }
                      ]
                    },
                    "else_": [],
                    "then": [
                      {
                        "Exec": {
                          "env": [],
                          "pipe": {
                            "stages": [
                              [
                                {
                                  "Lit": "printf"
                                },
                                {
                                  "Lit": "'#!/bin/sh\\nexec %s -fuse-ld=mold \"$@\"\\n'"
                                },
                                {
                                  "Lit": "\"$_src\""
                                }
                              ]
                            ],
                            "stderr": null,
                            "stdin": null,
                            "stdout": {
                              "append": false,
                              "target": {
                                "Lit": "\"$_mold_wrap/$_name\""
