                  "Lit": "gcc"
                },
                {
                  "Lit": "cc"
                },
                {
                  "Lit": "g++"
                },
                {
                  "Lit": "c++"
                },
                {
                  "Lit": "\"${_cc_triple}-gcc\""
                },
                {
                  "Lit": "\"${_cc_triple}-g++\""
