{
  "prelude": [
    {
      "Set": {
        "name": "_cc_triple",
        "value": {
          "Lit": "\"${PACKAGE_HOST:-$TRIPLE}\""
        }
      }
    },
    {
      "Comment": "Never export LD=*-gcc: libtool then reports \"is GNU ld... no\" and skips\nthe real -shared link (gmp install: dangling libgmp.so.*)."
    },
    {
      "Exec": {
        "env": [],
        "pipe": {
          "stages": [
            [
              {
                "Lit": "mkdir"
              },
              {
                "Lit": "-p"
              },
              {
                "Lit": "/tmp/la-overlay"
              },
              {
                "Lit": "/tmp/pc-overlay"
              }
            ]
          ],
          "stderr": null,
          "stdin": null,
          "stdout": null
        }
      }
    },
    {
      "Set": {
        "name": "_pc_wrap",
        "value": {
          "Lit": "/tmp/pkg-config-bin"
        }
      }
    },
    {
      "Exec": {
        "env": [],
        "pipe": {
          "stages": [
            [
              {
                "Lit": "mkdir"
              },
              {
                "Lit": "-p"
              },
              {
                "Lit": "\"$_pc_wrap\""
              }
            ]
          ],
          "stderr": null,
          "stdin": null,
          "stdout": null
        }
      }
    },
    {
      "If": {
        "cond": {
          "Cmd": {
            "stages": [
              [
                {
                  "Lit": "command"
                },
                {
                  "Lit": "-v"
                },
                {
                  "Lit": "pkgconf"
                }
              ]
            ],
            "stderr": {
              "Lit": "/dev/null"
            },
            "stdin": null,
            "stdout": {
              "append": false,
              "target": {
                "Lit": "/dev/null"
              }
            }
          }
        },
        "else_": [
          {
            "If": {
              "cond": {
                "Cmd": {
                  "stages": [
                    [
                      {
                        "Lit": "command"
                      },
                      {
                        "Lit": "-v"
                      },
                      {
                        "Lit": "pkg-config"
                      }
                    ]
                  ],
                  "stderr": {
                    "Lit": "/dev/null"
                  },
                  "stdin": null,
                  "stdout": {
                    "append": false,
                    "target": {
                      "Lit": "/dev/null"
                    }
                  }
                }
              },
              "else_": [],
              "then": [
                {
                  "WriteFile": {
                    "append": false,
                    "expand": false,
                    "lines": [
                      {
                        "Lit": "#!/bin/sh"
                      },
                      {
                        "Lit": "exec pkg-config \"$@\""
                      }
                    ],
                    "path": {
                      "Lit": "\"$_pc_wrap/pkg-config\""
                    }
                  }
                }
              ]
            }
          }
        ],
        "then": [
          {
            "WriteFile": {
              "append": false,
              "expand": false,
              "lines": [
                {
                  "Lit": "#!/bin/sh"
                },
                {
                  "Lit": "exec pkgconf \"$@\""
                }
              ],
              "path": {
                "Lit": "\"$_pc_wrap/pkg-config\""
              }
            }
          }
        ]
      }
    },
    {
      "If": {
        "cond": {
          "FileExists": {
            "Lit": "\"$_pc_wrap/pkg-config\""
          }
        },
        "else_": [],
        "then": [
          {
            "Exec": {
              "env": [],
              "pipe": {
                "stages": [
                  [
                    {
                      "Lit": "chmod"
                    },
                    {
                      "Lit": "+x"
                    },
                    {
                      "Lit": "\"$_pc_wrap/pkg-config\""
                    }
                  ]
                ],
                "stderr": null,
                "stdin": null,
                "stdout": null
              }
            }
          },
          {
            "Export": {
              "name": "PATH",
              "value": {
                "Lit": "\"$_pc_wrap:$PATH\""
              }
            }
          }
        ]
      }
    }
  ],
  "recipe": {
    "Steps": {
      "env": "None",
      "pgo": null,
      "std": "Gnu17",
      "steps": [
        {
          "Install": {
            "dst": "\"$OUT\"/etc/ssl/certs/ca-certificates.crt",
            "mode": "644",
            "src": "\"$SOURCE\"/certifi/cacert.pem"
          }
        },
        {
          "Symlink": {
            "force": false,
            "link": "\"$OUT\"/etc/ssl/certs/ca-bundle.crt",
            "target": "ca-certificates.crt"
          }
        },
        {
          "Symlink": {
            "force": false,
            "link": "\"$OUT\"/etc/ssl/cert.pem",
            "target": "certs/ca-certificates.crt"
          }
        }
      ],
      "sysroot": false,
      "workdir": "None"
    }
