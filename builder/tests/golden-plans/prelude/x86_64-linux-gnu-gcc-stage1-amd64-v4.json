        },
        "else_": [
          {
            "If": {
              "cond": {
                "Cmd": {
                  "stages": [
                    [
                      {
                        "Lit": "command"
                      },
                      {
                        "Lit": "-v"
                      },
                      {
                        "Lit": "pkg-config"
                      }
