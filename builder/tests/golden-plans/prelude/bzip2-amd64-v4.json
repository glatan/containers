                            "Lit": "cat"
                          },
                          {
                            "Lit": "./*.c"
                          },
                          {
                            "Lit": "./*.h"
                          }
                        ]
                      ],
                      "stderr": {
                        "Lit": "/dev/null"
                      },
                      "stdin": null,
                      "stdout": null
                    }
                  }
                }
              ],
              "items": [
                {
                  "Lit": "1"
                },
                {
                  "Lit": "2"
                },
                {
                  "Lit": "3"
                },
                {
                  "Lit": "4"
                },
                {
                  "Lit": "5"
                },
                {
                  "Lit": "6"
                },
                {
                  "Lit": "7"
                },
                {
                  "Lit": "8"
                }
