              "else_": [],
              "then": [
                {
                  "Exec": {
                    "env": [],
                    "pipe": {
                      "stages": [
                        [
                          {
                            "Lit": "./bzip2recover"
                          },
                          {
                            "Lit": "/tmp/pgo.bz2"
                          }
