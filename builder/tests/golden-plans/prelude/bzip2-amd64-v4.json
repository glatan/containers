                      ],
                      "stderr": {
                        "Lit": "/dev/null"
                      },
                      "stdin": null,
                      "stdout": {
                        "append": false,
                        "target": {
                          "Lit": "/dev/null"
                        }
                      }
                    }
                  }
                }
              ]
