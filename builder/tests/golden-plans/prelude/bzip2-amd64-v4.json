      "std": "Gnu17",
      "steps": [
        {
          "Exec": {
            "env": [],
            "pipe": {
              "stages": [
                [
                  {
                    "Lit": "sed"
                  },
                  {
                    "Lit": "-i"
                  },
                  {
                    "Lit": "'s/$(CC) -shared/$(CC) $(LDFLAGS) -shared/'"
                  },
                  {
                    "Lit": "Makefile-libbz2_so"
                  }
                ]
              ],
              "stderr": null,
              "stdin": null,
              "stdout": null
            }
          }
        },
        {
          "Make": {
            "args": [
              "-f",
              "Makefile-libbz2_so",
              "CC=\"$CC\"",
              "CFLAGS=\"$CFLAGS -fpic -fPIC -Wall -Winline -D_FILE_OFFSET_BITS=64\"",
              "LDFLAGS=\"$LDFLAGS\""
            ],
            "jobs": false
          }
        },
        {
          "Make": {
            "args": [
              "CC=\"$CC\"",
              "AR=\"${AR:-${TRIPLE}-ar}\"",
              "RANLIB=\"${RANLIB:-${TRIPLE}-ranlib}\"",
