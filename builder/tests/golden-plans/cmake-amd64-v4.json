{
  "Steps": {
    "env": "Autotools",
    "pgo": null,
    "std": "Gnu17",
    "steps": [
      {
        "ConfigureScript": {
          "args": [
            {
              "Lit": "--prefix=/usr"
            },
            {
              "Concat": [
                {
                  "Lit": "--parallel="
                },
                {
                  "Subst": {
                    "stages": [
                      [
                        {
                          "Lit": "nproc"
                        }
                      ]
                    ],
                    "stderr": null,
                    "stdin": null,
                    "stdout": null
                  }
                }
              ]
            },
            {
              "Lit": "--"
            },
            {
              "Lit": "-DCMAKE_SYSROOT=/tmp/sysroot"
            },
            {
              "Lit": "-DCMAKE_USE_OPENSSL=OFF"
            },
            {
              "Lit": "-DCMAKE_DISABLE_FIND_PACKAGE_Libidn2=ON"
            }
          ],
          "env": [],
          "program": [
            {
              "Concat": [
                {
                  "Quoted": {
                    "Var": "SOURCE"
                  }
                },
                {
                  "Lit": "/bootstrap"
                }
              ]
            }
          ]
        }
      },
      {
        "Make": {
          "args": [],
          "jobs": true
        }
      },
      {
        "MakeInstall": {
          "vars": []
        }
      }
    ],
    "sysroot": true,
    "workdir": "Build"
  }
}
