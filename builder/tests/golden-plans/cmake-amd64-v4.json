                    }
                  ]
                },
                {
                  "Lit": "--"
                },
                {
                  "Lit": "-DCMAKE_SYSROOT=/tmp/sysroot"
                },
                {
                  "Lit": "-DCMAKE_USE_OPENSSL=OFF"
                },
                {
                  "Lit": "-DCMAKE_DISABLE_FIND_PACKAGE_Libidn2=ON"
                }
              ]
            ],
            "stderr": null,
            "stdin": null,
            "stdout": null
          }
        }
      },
      {
        "Make": {
          "args": [],
          "jobs": true
        }
      },
      {
        "MakeInstall": {
          "vars": []
        }
      }
    ],
    "sysroot": true,
    "workdir": "Build"
