{
  "Steps": {
    "env": "Lto",
    "pgo": {
      "Autotools": [
        {
          "Exec": {
            "env": [],
            "pipe": {
              "stages": [
                [
                  {
                    "Lit": "./bash"
                  },
                  {
                    "Lit": "-c"
                  },
                  {
                    "Lit": "'\nx=0; for i in $(seq 1 10000); do x=$((x+i)); done; echo \"$x\" > /dev/null\ns=\"\"; for f in \"$SOURCE\"/*; do s=\"$s${f##*/}\"; done; echo \"${#s}\" > /dev/null\nfor i in $(seq 1 2000); do v=\"abc$i\"; printf \"%s\" \"${v%[0-9]*}${v##*[a-z]}\" > /dev/null; done\nshopt -s nullglob; for f in \"$SOURCE\"/*.{c,h} \"$SOURCE\"/*/*.c; do echo \"${#f}\" > /dev/null; done\n'"
                  }
                ]
              ],
              "stderr": null,
              "stdin": null,
              "stdout": null
            }
          }
        }
      ]
    },
    "std": "Gnu17",
    "steps": [
      {
        "Export": {
          "name": "CFLAGS_FOR_BUILD",
          "value": {
            "Lit": "\"-O2 -std=gnu17\""
          }
        }
      },
      {
        "Configure": [
          "--prefix=/usr",
          "--without-bash-malloc"
        ]
      },
      {
        "Make": {
          "args": [],
          "jobs": true
        }
      },
      {
        "MakeInstall": {
          "vars": []
        }
      },
      {
        "Symlink": {
          "force": true,
          "link": "\"$OUT\"/usr/bin/sh",
          "target": "bash"
        }
      }
    ],
    "sysroot": true,
    "workdir": "Build"
  }
}
