{
  "Steps": {
    "env": "None",
    "pgo": null,
    "std": "Gnu17",
    "steps": [
      {
        "If": {
          "cond": {
            "EnvSet": "SYSROOT"
          },
          "else_": [],
          "then": [
            {
              "Export": {
                "name": "CC",
                "value": {
                  "Quoted": {
                    "Concat": [
                      {
                        "Var": "CC"
                      },
                      {
                        "Lit": " --sysroot="
                      },
                      {
                        "Var": "SYSROOT"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      {
        "ConfigureScript": {
          "args": [
            {
              "Lit": "linux-x86_64"
            },
            {
              "Lit": "--prefix=/usr"
            },
            {
              "Lit": "--openssldir=/etc/ssl"
            },
            {
              "Lit": "--libdir=lib64"
            }
          ],
          "env": [],
          "program": [
            {
              "Quoted": {
                "Concat": [
                  {
                    "Var": "SOURCE"
                  },
                  {
                    "Lit": "/Configure"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "Export": {
          "name": "PGODIR",
          "value": {
            "Lit": "/tmp/pgo"
          }
        }
      },
      {
        "Exec": {
          "env": [],
          "pipe": {
            "stages": [
              [
                {
                  "Lit": "rm"
                },
                {
                  "Lit": "-rf"
                },
                {
                  "Quoted": {
                    "Var": "PGODIR"
                  }
                }
              ]
            ],
            "stderr": null,
            "stdin": null,
            "stdout": null
          }
        }
      },
      {
        "Exec": {
          "env": [],
          "pipe": {
            "stages": [
              [
                {
                  "Lit": "mkdir"
                },
                {
                  "Lit": "-p"
                },
                {
                  "Quoted": {
                    "Var": "PGODIR"
                  }
                }
              ]
            ],
            "stderr": null,
            "stdin": null,
            "stdout": null
          }
        }
      },
      {
        "Make": {
          "args": [
            "CFLAGS=\"$CFLAGS -fprofile-generate=$PGODIR -fprofile-update=atomic\"",
            "LDFLAGS=\"$LDFLAGS -fprofile-generate\""
          ],
          "jobs": true
        }
      },
      {
        "Export": {
          "name": "LD_LIBRARY_PATH",
          "value": {
            "Quoted": {
              "Concat": [
                {
                  "Var": "PWD"
                },
                {
                  "Lit": "${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
                }
              ]
            }
          }
        }
      },
      {
        "Export": {
          "name": "OPENSSL_MODULES",
          "value": {
            "Quoted": {
              "Concat": [
                {
                  "Var": "PWD"
                },
                {
                  "Lit": "/providers"
                }
              ]
            }
          }
        }
      },
      {
        "Export": {
          "name": "OPENSSL_CONF",
          "value": {
            "Lit": "/dev/null"
          }
        }
      },
      {
        "Or": {
          "lhs": [
            {
              "Exec": {
                "env": [],
                "pipe": {
                  "stages": [
                    [
                      {
                        "Lit": "./apps/openssl"
                      },
                      {
                        "Lit": "speed"
                      },
                      {
                        "Lit": "-seconds"
                      },
                      {
                        "Lit": "1"
                      },
                      {
                        "Lit": "rsa2048"
                      },
                      {
                        "Lit": "ecdsap256"
                      },
                      {
                        "Lit": "ed25519"
                      }
                    ]
                  ],
                  "stderr": null,
                  "stdin": null,
                  "stdout": null
                }
              }
            },
            {
              "Exec": {
                "env": [],
                "pipe": {
                  "stages": [
                    [
                      {
                        "Lit": "./apps/openssl"
                      },
                      {
                        "Lit": "speed"
                      },
                      {
                        "Lit": "-seconds"
                      },
                      {
                        "Lit": "1"
                      },
                      {
                        "Lit": "-evp"
                      },
                      {
                        "Lit": "aes-128-gcm"
                      },
                      {
                        "Lit": "-evp"
                      },
                      {
                        "Lit": "aes-256-gcm"
                      },
                      {
                        "Lit": "-evp"
                      },
                      {
                        "Lit": "chacha20-poly1305"
                      },
                      {
                        "Lit": "-evp"
                      },
                      {
                        "Lit": "sha256"
                      },
                      {
                        "Lit": "-evp"
                      },
                      {
                        "Lit": "sha512"
                      }
                    ]
                  ],
                  "stderr": null,
                  "stdin": null,
                  "stdout": null
                }
              }
            },
            {
              "Exec": {
                "env": [],
                "pipe": {
                  "stages": [
                    [
                      {
                        "Lit": "./apps/openssl"
                      },
                      {
                        "Lit": "speed"
                      },
                      {
                        "Lit": "-seconds"
                      },
                      {
                        "Lit": "1"
                      },
                      {
                        "Lit": "aes-128-cbc"
                      },
                      {
                        "Lit": "aes-256-cbc"
                      },
                      {
                        "Lit": "sha256"
                      },
                      {
                        "Lit": "sha512"
                      }
                    ]
                  ],
                  "stderr": null,
                  "stdin": null,
                  "stdout": null
                }
              }
            }
          ],
          "rhs": [
            {
              "Exec": {
                "env": [],
                "pipe": {
                  "stages": [
                    [
                      {
                        "Lit": "true"
                      }
                    ]
                  ],
                  "stderr": null,
                  "stdin": null,
                  "stdout": null
                }
              }
            }
          ]
        }
      },
      {
        "Make": {
          "args": [
            "clean"
          ],
          "jobs": false
        }
      },
      {
        "Make": {
          "args": [
            "CFLAGS=\"$CFLAGS -fprofile-use=$PGODIR -fprofile-correction -Wno-missing-profile -Wno-error=coverage-mismatch\"",
            "LDFLAGS=\"$LDFLAGS -fprofile-use\""
          ],
          "jobs": true
        }
      },
      {
        "Exec": {
          "env": [],
          "pipe": {
            "stages": [
              [
                {
                  "Lit": "make"
                },
                {
                  "Lit": "install_sw"
                },
                {
                  "Concat": [
                    {
                      "Lit": "DESTDIR="
                    },
                    {
                      "Quoted": {
                        "Var": "OUT"
                      }
                    }
                  ]
                }
              ]
            ],
            "stderr": null,
            "stdin": null,
            "stdout": null
          }
        }
      }
    ],
    "sysroot": true,
    "workdir": "Build"
  }
}
