{
  "Steps": {
    "env": "Autotools",
    "pgo": null,
    "std": "Gnu17",
    "steps": [
      {
        "Exec": {
          "env": [],
          "pipe": {
            "stages": [
              [
                {
                  "Lit": "cmake"
                },
                {
                  "Lit": "-S"
                },
                {
                  "Lit": "."
                },
                {
                  "Lit": "-B"
                },
                {
                  "Lit": "build-cmake"
                },
                {
                  "Lit": "-DCMAKE_SYSTEM_NAME=Linux"
                },
                {
                  "Lit": "-DCMAKE_SYSTEM_PROCESSOR=aarch64"
                },
                {
                  "Lit": "-DCMAKE_SYSROOT=/tmp/sysroot"
                },
                {
                  "Lit": "-DCMAKE_BUILD_TYPE=Release"
                },
                {
                  "Lit": "-DCMAKE_INSTALL_PREFIX=/usr"
                },
                {
                  "Lit": "-DBUILD_TESTING=OFF"
                },
                {
                  "Concat": [
                    {
                      "Lit": "-DCMAKE_C_COMPILER="
                    },
                    {
                      "Quoted": {
                        "Var": "CC"
                      }
                    }
                  ]
                },
                {
                  "Concat": [
                    {
                      "Lit": "-DCMAKE_CXX_COMPILER="
                    },
                    {
                      "Quoted": {
                        "Var": "CXX"
                      }
                    }
                  ]
                }
              ]
            ],
            "stderr": null,
            "stdin": null,
            "stdout": null
          }
        }
      },
      {
        "Exec": {
          "env": [],
          "pipe": {
            "stages": [
              [
                {
                  "Lit": "cmake"
                },
                {
                  "Lit": "--build"
                },
                {
                  "Lit": "build-cmake"
                },
                {
                  "Concat": [
                    {
                      "Lit": "-j"
                    },
                    {
                      "Subst": {
                        "stages": [
                          [
                            {
                              "Lit": "nproc"
                            }
                          ]
                        ],
                        "stderr": null,
                        "stdin": null,
                        "stdout": null
                      }
                    }
                  ]
                }
              ]
            ],
            "stderr": null,
            "stdin": null,
            "stdout": null
          }
        }
      },
      {
        "Exec": {
          "env": [],
          "pipe": {
            "stages": [
              [
                {
                  "Lit": "cp"
                },
                {
                  "Lit": "build-cmake/ninja"
                },
                {
                  "Lit": "ninja"
                }
              ]
            ],
            "stderr": null,
            "stdin": null,
            "stdout": null
          }
        }
      },
      {
        "Install": {
          "dst": "\"$OUT\"/usr/bin/ninja",
          "mode": "755",
          "src": "ninja"
        }
      }
    ],
    "sysroot": true,
    "workdir": "InSource"
  }
}
