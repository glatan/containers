{
  "Steps": {
    "env": "Autotools",
    "pgo": {
      "Autotools": [
        {
          "Exec": {
            "env": [],
            "pipe": {
              "stages": [
                [
                  {
                    "Lit": "./src/grep"
                  },
                  {
                    "Lit": "-r"
                  },
                  {
                    "Lit": "-E"
                  },
                  {
                    "Lit": "'int|char'"
                  },
                  {
                    "Lit": "\"$SOURCE\""
                  }
                ]
              ],
              "stderr": null,
              "stdin": null,
              "stdout": {
                "append": false,
                "target": {
                  "Lit": "/dev/null"
                }
              }
            }
          }
        },
        {
          "Exec": {
            "env": [],
            "pipe": {
              "stages": [
                [
                  {
                    "Lit": "./src/grep"
                  },
                  {
                    "Lit": "-r"
                  },
                  {
                    "Lit": "-F"
                  },
                  {
                    "Lit": "'include'"
                  },
                  {
                    "Lit": "\"$SOURCE\""
                  }
                ]
              ],
              "stderr": null,
              "stdin": null,
              "stdout": {
                "append": false,
                "target": {
                  "Lit": "/dev/null"
                }
              }
            }
          }
        },
        {
          "Exec": {
            "env": [],
            "pipe": {
              "stages": [
                [
                  {
                    "Lit": "./src/grep"
                  },
                  {
                    "Lit": "-r"
                  },
                  {
                    "Lit": "-i"
                  },
                  {
                    "Lit": "-w"
                  },
                  {
                    "Lit": "'main'"
                  },
                  {
                    "Lit": "\"$SOURCE\""
                  }
                ]
              ],
              "stderr": null,
              "stdin": null,
              "stdout": {
                "append": false,
                "target": {
                  "Lit": "/dev/null"
                }
              }
            }
          }
        },
        {
          "Exec": {
            "env": [],
            "pipe": {
              "stages": [
                [
                  {
                    "Lit": "printf"
                  },
                  {
                    "Lit": "'a\\0b\\0c'"
                  }
                ],
                [
                  {
                    "Lit": "./src/grep"
                  },
                  {
                    "Lit": "-a"
                  },
                  {
                    "Lit": "'b'"
                  }
                ]
              ],
              "stderr": null,
              "stdin": null,
              "stdout": {
                "append": false,
                "target": {
                  "Lit": "/dev/null"
                }
              }
            }
          }
        }
      ]
    },
    "std": "Gnu17",
    "steps": [
      {
        "Configure": [
          "--prefix=/usr"
        ]
      },
      {
        "Make": {
          "args": [],
          "jobs": true
        }
      },
      {
        "MakeInstall": {
          "vars": []
        }
      }
    ],
    "sysroot": true,
    "workdir": "Build"
  }
}
